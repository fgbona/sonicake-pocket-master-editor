{
  "name": "sonicake-pocket-master-mcp",
  "version": "1.3.0",
  "description": "Unofficial MCP server for the Sonicake Pocket Master: let an AI assistant build tones from a record, edit and save presets over USB MIDI.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sonicake",
    "pocket-master",
    "guitar",
    "midi",
    "sysex",
    "claude"
  ],
  "homepage": "https://github.com/fgbona/OpenSonicX#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fgbona/OpenSonicX.git",
    "directory": "apps/mcp"
  },
  "bugs": "https://github.com/fgbona/OpenSonicX/issues",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "sonicake-pocket-master-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "start": "node src/server.ts",
    "build": "node build.mjs",
    "prepack": "npm run build",
    "test": "node --test --test-timeout=5000 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@julusian/midi": "3.9.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "@pocket-master/core": "*",
    "esbuild": "0.28.2"
  }
}
