{
  "name": "@pocket-master/web",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:worker": "esbuild lib/convert.worker.ts --bundle --format=esm --target=es2022 --outfile=public/convert-worker.js --log-level=warning",
    "predev": "npm run build:worker",
    "dev": "next dev",
    "prebuild": "npm run build:worker",
    "build": "next build",
    "postbuild": "node scripts/build-sw.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=5000 'test/**/*.test.ts'",
    "e2e": "playwright test && playwright test -c playwright.pwa.config.ts",
    "e2e:pwa": "playwright test -c playwright.pwa.config.ts",
    "e2e:live": "playwright test e2e/live-ai.spec.ts"
  },
  "dependencies": {
    "@pocket-master/core": "*",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
